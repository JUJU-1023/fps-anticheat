<Window x:Class="AntiCheatDashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:AntiCheatDashboard.Views"
        Title="Anti-Cheat Dashboard" Width="1400" Height="860"
        MinWidth="1024" MinHeight="600"
        Loaded="Window_Loaded">
    <DockPanel>

        <!-- 상단: 연결 상태 -->
        <Border DockPanel.Dock="Top" Padding="12,8" Background="#1E1E1E">
            <DockPanel>
                <Button x:Name="TestButton" DockPanel.Dock="Right" Content="연결 테스트"
                        Padding="14,4" Click="TestButton_Click" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="Gray" Margin="0,0,8,0" />
                    <TextBlock Text="Anti-Cheat Dashboard" Foreground="White" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock x:Name="ServerText" Foreground="#9E9E9E" Margin="16,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 하단: 상태줄 -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="대기 중" />
            </StatusBarItem>
        </StatusBar>

        <!-- 본문 탭 -->
        <TabControl x:Name="Tabs" Margin="8">
            <TabItem x:Name="LiveTab" Header="실시간 위반">
                <views:LiveViolationsView Margin="8" />
            </TabItem>
            <TabItem Header="세션">
                <TextBlock Text="Day 3" Margin="16" Foreground="Gray" />
            </TabItem>
            <TabItem Header="플레이어">
                <TextBlock Text="Day 3 (킥/밴은 Day 4)" Margin="16" Foreground="Gray" />
            </TabItem>
            <TabItem x:Name="DiagTab" Header="진단">
                <TextBox x:Name="DiagOutput" IsReadOnly="True" FontFamily="Consolas" FontSize="13"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         BorderThickness="0" Padding="8" />
            </TabItem>
        </TabControl>

    </DockPanel>
</Window>
