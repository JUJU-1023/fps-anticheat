<Window x:Class="AntiCheatDashboard.Views.BanDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="플레이어 제재" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Loaded="OnLoaded">
    <StackPanel Margin="18">

        <TextBlock x:Name="PlayerTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="CurrentStatus" Foreground="Gray" Margin="0,4,0,14" TextWrapping="Wrap" />

        <!-- 조치 -->
        <TextBlock Text="조치" FontWeight="SemiBold" Margin="0,0,0,4" />
        <RadioButton x:Name="KickRadio" GroupName="Action" IsChecked="True" Margin="0,0,0,4"
                     Checked="Action_Changed">
            <TextBlock>
                <Run Text="킥" FontWeight="SemiBold" />
                <Run Text="  지금 접속을 끊음. 재접속은 허용" Foreground="#555" />
            </TextBlock>
        </RadioButton>
        <RadioButton x:Name="BanRadio" GroupName="Action" Checked="Action_Changed">
            <TextBlock>
                <Run Text="밴" FontWeight="SemiBold" />
                <Run Text="  끊고, 기간 동안 재접속 거부" Foreground="#555" />
            </TextBlock>
        </RadioButton>

        <StackPanel Orientation="Horizontal" Margin="22,8,0,14">
            <TextBlock Text="기간" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="DurationBox" Width="120" IsEnabled="False" SelectionChanged="Duration_Changed">
                <ComboBoxItem Content="1시간" Tag="60" IsSelected="True" />
                <ComboBoxItem Content="1일" Tag="1440" />
                <ComboBoxItem Content="7일" Tag="10080" />
                <ComboBoxItem Content="영구" Tag="" />
            </ComboBox>
        </StackPanel>

        <!-- 근거 -->
        <TextBlock Text="근거 위반" FontWeight="SemiBold" Margin="0,0,0,4" />
        <ComboBox x:Name="ViolationBox" DisplayMemberPath="Text" Margin="0,0,0,14"
                  SelectionChanged="ViolationBox_SelectionChanged" />

        <TextBlock Text="사유 (필수)" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBox x:Name="ReasonBox" MaxLength="255" Height="56" TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto" TextChanged="ReasonBox_TextChanged" />

        <TextBlock x:Name="Notice" Foreground="Gray" TextWrapping="Wrap" Margin="0,12,0,0" />
        <TextBlock x:Name="ErrorText" Foreground="#C62828" TextWrapping="Wrap" Margin="0,6,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="ExecuteButton" Content="킥 실행" Padding="18,5" Margin="0,0,8,0"
                    FontWeight="SemiBold" Click="Execute_Click" />
            <Button Content="취소" Padding="18,5" IsCancel="True" />
        </StackPanel>

    </StackPanel>
</Window>
