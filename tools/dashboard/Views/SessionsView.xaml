<UserControl x:Class="AntiCheatDashboard.Views.SessionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <DockPanel>

        <!-- 필터 바 -->
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="레이블" VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="LabelBox" Width="100" Margin="0,0,16,0" SelectionChanged="Filter_SelectionChanged">
                <ComboBoxItem Content="전체" IsSelected="True" />
                <ComboBoxItem Content="clean" />
                <ComboBoxItem Content="cheat" />
                <ComboBoxItem Content="mixed" />
                <ComboBoxItem Content="unknown" />
            </ComboBox>
            <CheckBox x:Name="ExcludeBox" Content="오염 데이터 제외" IsChecked="True"
                      VerticalAlignment="Center" Margin="0,0,16,0"
                      Checked="Filter_Toggled" Unchecked="Filter_Toggled" />
            <Button Content="새로고침" Padding="10,2" Click="Refresh_Click" />
        </WrapPanel>

        <TextBlock x:Name="StatusLine" DockPanel.Dock="Bottom" Margin="0,6,0,0" Foreground="Gray" />

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="5" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>

            <!-- 매치 목록 -->
            <DataGrid x:Name="MatchGrid" Grid.Row="0"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E0E0E0"
                      SelectionChanged="MatchGrid_SelectionChanged">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Label}" Value="cheat">
                                <Setter Property="Background" Value="#FFEDED" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Label}" Value="mixed">
                                <Setter Property="Background" Value="#FFF4E0" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Excluded}" Value="True">
                                <Setter Property="Foreground" Value="#9E9E9E" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="매치" Binding="{Binding Id}" Width="56" />
                    <DataGridTextColumn Header="레이블" Binding="{Binding Label}" Width="70" />
                    <DataGridTextColumn Header="시작 (KST)" Binding="{Binding StartText}" Width="110" SortMemberPath="StartKst" />
                    <DataGridTextColumn Header="길이" Binding="{Binding DurationText}" Width="90" />
                    <DataGridTextColumn Header="맵" Binding="{Binding Map}" Width="110" />
                    <DataGridTextColumn Header="교전 인원" Binding="{Binding Players}" Width="68" />
                    <DataGridTextColumn Header="발사" Binding="{Binding Fires, StringFormat=N0}" Width="70" />
                    <DataGridTextColumn Header="킬" Binding="{Binding Kills, StringFormat=N0}" Width="50" />
                    <DataGridTextColumn Header="위반 합계" Binding="{Binding ViolationText}" Width="110" SortMemberPath="ViolationTotal" />
                    <DataGridTextColumn Header="메모" Binding="{Binding Notes}" Width="*" MinWidth="120" />
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" />

            <!-- 선택한 매치의 참가자 -->
            <DockPanel Grid.Row="2">
                <TextBlock x:Name="DetailHeader" DockPanel.Dock="Top" Margin="0,6,0,6"
                           FontWeight="SemiBold" Text="매치를 선택하면 참가자별 전적이 표시됩니다" />
                <DataGrid x:Name="PlayerGrid"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E0E0E0">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasViolations}" Value="True">
                                    <Setter Property="Background" Value="#FFEDED" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="플레이어" Binding="{Binding PlayerText}" Width="170" />
                        <DataGridTextColumn Header="발사" Binding="{Binding Fires, StringFormat=N0}" Width="60" />
                        <DataGridTextColumn Header="명중" Binding="{Binding Hits, StringFormat=N0}" Width="60" />
                        <DataGridTextColumn Header="명중률" Binding="{Binding AccuracyText}" Width="64" />
                        <DataGridTextColumn Header="헤드샷률" Binding="{Binding HeadshotText}" Width="70" />
                        <DataGridTextColumn Header="킬" Binding="{Binding Kills}" Width="44" />
                        <DataGridTextColumn Header="데스" Binding="{Binding Deaths}" Width="44" />
                        <DataGridTextColumn Header="K/D" Binding="{Binding KdText}" Width="52" />
                        <DataGridTextColumn Header="평균 RTT" Binding="{Binding RttText}" Width="64" />
                        <DataGridTextColumn Header="위반 합계" Binding="{Binding ViolationTotal, StringFormat=N0}" Width="72" />
                        <DataGridTextColumn Header="코드별 위반" Binding="{Binding ViolationText}" Width="*" MinWidth="160" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>

    </DockPanel>
</UserControl>
