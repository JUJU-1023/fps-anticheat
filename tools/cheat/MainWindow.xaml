<Window x:Class="CheatClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cheat Client (외부) — W11 에임핵" Height="620" Width="500"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <Button x:Name="AttachBtn" Content="게임에 연결" Width="120" Height="32" Click="OnAttach"/>
            <TextBlock x:Name="StatusText" Text="미연결" VerticalAlignment="Center"
                       Margin="12,0,0,0" FontWeight="Bold"/>
        </StackPanel>

        <Border Grid.Row="1" Margin="0,12,0,0" Padding="10" Background="#11000000" CornerRadius="4">
            <StackPanel>
                <TextBlock x:Name="PidText"      Text="PID: -"/>
                <TextBlock x:Name="MonoBaseText" Text="mono-2.0-bdwgc.dll: -"/>
                <TextBlock x:Name="AimText"      Text="조준: yaw - / pitch -" FontWeight="Bold"/>
                <!-- W11 : 내 위치 / 적 위치 -->
                <TextBlock x:Name="PosText"      Text="내 위치: -" Margin="0,6,0,0"/>
                <TextBlock x:Name="EnemyText"    Text="적: -" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="에임핵" FontWeight="Bold" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <TextBlock Text="yaw"   VerticalAlignment="Center" Width="36"/>
                <TextBox x:Name="YawBox"   Text="180" Width="70" Height="26"/>
                <TextBlock Text="pitch" VerticalAlignment="Center" Width="40" Margin="12,0,0,0"/>
                <TextBox x:Name="PitchBox" Text="0"   Width="70" Height="26"/>
            </StackPanel>
            <WrapPanel>
                <ToggleButton x:Name="LockToggle" Content="조준 고정" Width="120" Height="30"
                              IsEnabled="False"
                              Checked="OnLockChecked" Unchecked="OnLockUnchecked"/>
                <!-- W11 : 자동 조준. 수동 고정과 동시에 켜지지 않는다 (코드비하인드에서 처리) -->
                <ToggleButton x:Name="AutoToggle" Content="자동 조준" Width="120" Height="30"
                              Margin="8,0,0,0" IsEnabled="False"
                              Checked="OnAutoChecked" Unchecked="OnAutoUnchecked"/>
            </WrapPanel>
            <TextBlock Text="※ 조준 고정: 위 각도로 잠김. 서버 input.yaw/pitch 에 반영됨."
                       FontSize="10" Foreground="#888" Margin="0,4,0,0"/>
            <TextBlock Text="※ 자동 조준: 우클릭 누르는 동안 조준선 30° 안 가장 가까운 적 몸통을 겨눔."
                       FontSize="10" Foreground="#888" Margin="0,2,0,0"/>
        </StackPanel>

        <TextBox Grid.Row="3" x:Name="LogBox" Margin="0,12,0,0"
                 IsReadOnly="True" VerticalScrollBarVisibility="Auto"
                 FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
    </Grid>
</Window>
